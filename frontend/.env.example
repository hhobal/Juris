# Copie para .env.local e preencha.
#
# A anon key é pública por desenho — ela vai para o bundle do navegador de
# qualquer forma. Quem protege os dados é a RLS. NUNCA coloque aqui a
# service_role key: ela ignora RLS por completo.

VITE_SUPABASE_URL=https://adxdacqisxsynxvcoerr.supabase.co
VITE_SUPABASE_ANON_KEY=

# Para apontar no Supabase local (npx supabase start), use:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<o ANON_KEY que o "supabase start" imprime>
